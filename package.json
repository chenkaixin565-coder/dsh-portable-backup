{
  "name": "dsh-portable",
  "version": "1.0.0",
  "description": "Portable backup, restore and migration for DeepSeek Harness sessions on Windows, with zero third-party dependencies.",
  "type": "module",
  "private": true,
  "bin": {
    "dsh-portable": "./dsh-portable.mjs"
  },
  "scripts": {
    "start": "node dsh-portable.mjs",
    "list": "node dsh-portable.mjs list",
    "check": "node --check dsh-portable.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "session",
    "backup",
    "restore",
    "migration",
    "portable"
  ],
  "license": "MIT",
  "files": [
    "dsh-portable.mjs",
    "dsh-portable.cmd",
    "lib/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ]
}
